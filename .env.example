# Server Port
PORT=3000

# Environment Mode (Must be set to "production" when deployed!)
NODE_ENV=production

# Database (Replace with your actual MongoDB URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pinboxx?appName=Cluster0

# Authentication (Change this to a strong random string in production)
JWT_SECRET=pinboxx2024

# Admin Panel Configuration
ADMIN_PASSWORD_HASH=$2b$10$... # Generate a bcrypt hash for your admin password
COBOX_ADMIN_ORIGIN=https://admin.aiplex.app # (Optional) If you have a separate admin dashboard origin

# Temporary Email Backend (Gmail IMAP config)
GMAIL_EMAIL=support@aiplex.app
GMAIL_APP_PASSWORD=your-16-char-app-password

# Razorpay Configuration (Switch these to Live Keys in production)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_live_key_secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Sentry Error Tracking (Optional but highly recommended)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
